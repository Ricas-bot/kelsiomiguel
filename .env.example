# Copy to .env.local (never commit real .env files).

# Public URL of the site, without a trailing slash, e.g. https://kelsiomiguel.com
# Enables canonical URLs, hreflang, the sitemap and absolute social-share images.
# On Vercel it can stay empty: the production URL is detected automatically
# (VERCEL_PROJECT_PRODUCTION_URL). Elsewhere it must be set BEFORE `npm run build`.
NEXT_PUBLIC_SITE_URL=
